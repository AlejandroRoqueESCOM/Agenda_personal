<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvHeaderDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:text="Lunes, 12 de Mayo 2025"
        android:textColor="@color/primaryColor"
        android:textStyle="bold"
        android:textSize="14sp"
        android:visibility="gone"
        tools:visibility="visible"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEvento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="6dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/backgroundLight"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCategoriaItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categoría"
                android:textColor="@android:color/white"
                app:chipBackgroundColor="@color/primaryColor"
                app:chipMinHeight="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvFechaHoraItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha y Hora"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/chipCategoriaItem"
                app:layout_constraintBottom_toBottomOf="@+id/chipCategoriaItem"/>

            <TextView
                android:id="@+id/tvDescripcionItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Descripción del evento"
                android:textSize="16sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/chipCategoriaItem" />

            <TextView
                android:id="@+id/tvStatusItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Status"
                android:textColor="@color/secondaryColor"
                android:textStyle="italic"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDescripcionItem" />

            <ImageView
                android:id="@+id/imgContacto"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_menu_call"
                app:tint="@color/black"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toEndOf="@+id/tvStatusItem"
                app:layout_constraintTop_toTopOf="@+id/tvStatusItem"
                app:layout_constraintBottom_toBottomOf="@+id/tvStatusItem"/>

            <TextView
                android:id="@+id/tvContactoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contacto"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toEndOf="@+id/imgContacto"
                app:layout_constraintTop_toTopOf="@+id/imgContacto"
                app:layout_constraintBottom_toBottomOf="@+id/imgContacto"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>